rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /guests/{guestId} {
      // Anyone can submit a check-in form, provided mandatory fields exist
      allow create: if request.resource.data.guestDetails.name != null 
                    && request.resource.data.guestDetails.phone != null;

      // Allow reading guest records (In production, restrict to authenticated staff: request.auth != null)
      allow read: if true; 
      
      // Restrict edits/deletions
      allow update, delete: if true;
    }
  }
}